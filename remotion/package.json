{
  "name": "quran-cinematic-remotion",
  "version": "1.0.0",
  "description": "Premium cinematic Qur'an recitation video, built with Remotion + React + TypeScript.",
  "license": "MIT",
  "scripts": {
    "dev": "remotion studio",
    "generate": "node scripts/generate.mjs",
    "make": "node scripts/generate.mjs && remotion render IslamicReflection out/reflection.mp4 --codec=h264 --crf=16 --image-format=jpeg",
    "render": "remotion render IslamicReflection out/reflection.mp4 --codec=h264 --crf=16 --image-format=jpeg",
    "render:quran": "remotion render QuranShort out/video.mp4 --codec=h264 --crf=16 --image-format=jpeg",
    "render:hq": "remotion render IslamicReflection out/reflection.mp4 --codec=h264 --crf=12 --image-format=png",
    "still": "remotion still IslamicReflection out/still.png",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@fontsource/amiri": "^5.0.0",
    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/playfair-display": "^5.0.0",
    "@fontsource/poppins": "^5.0.0",
    "@remotion/cli": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
