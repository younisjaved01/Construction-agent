# Copy to ".env" (git-ignored) or export these before `npm run make`.

# Narration TTS provider: elevenlabs | mock
NARRATION_PROVIDER=elevenlabs

# ElevenLabs (https://elevenlabs.io → Profile → API Keys)
ELEVENLABS_API_KEY=sk_your_key_here
# Optional: pick a voice (default is a warm neutral voice). Voice IDs are in your
# ElevenLabs "Voices" library.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Optional: auto-generate the reflection from the verse if brief.reflection is empty
# ANTHROPIC_API_KEY=sk-ant-...
