# Copy to .env. Only the pieces you actually use need values.

# Core infra (docker-compose provides these locally)
DATABASE_URL=postgresql://factory:factory@localhost:5432/factory
REDIS_URL=redis://localhost:6379

# Asset store: "local" (filesystem, dev default) or "s3" (MinIO / Cloudflare R2)
ASSET_STORE=local
ASSET_LOCAL_DIR=./data/assets
# S3 / R2 (only if ASSET_STORE=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=factory-assets
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=auto

# Provider API keys (only for the adapters you enable in config/providers.yaml)
# --- LLM / script (pick ONE) ---
GROQ_API_KEY=              # console.groq.com/keys  (free, no region lock — recommended)
GEMINI_API_KEY=            # aistudio.google.com/apikey  (free tier NOT available everywhere)
OPENAI_API_KEY=            # platform.openai.com/api-keys  (paid)
# OPENAI_BASE_URL=         # optional: override for any OpenAI-compatible endpoint
# --- image / video ---
FAL_KEY=
# --- voice ---
ELEVENLABS_API_KEY=
# Local services
COMFYUI_URL=http://localhost:8188

LOG_LEVEL=info
